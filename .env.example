# Sales enquiry delivery — app/api/inquiry/route.ts (Resend).
# Required in production; with these unset locally the endpoint logs the lead
# and still succeeds so the form can be exercised in dev.

# Resend API key: https://resend.com/api-keys (sending access is enough).
RESEND_API_KEY=

# Where the lead notification is delivered. Replies go to the enquirer.
INQUIRY_TO=sales@reya.cy

# Sender. The domain must be verified in Resend — reya.cy is.
INQUIRY_FROM="Reya <noreply@reya.cy>"
